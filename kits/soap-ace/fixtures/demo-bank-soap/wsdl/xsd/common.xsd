<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic demo-bank common types. No real data. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:cmn="http://demobank.example/soap/common"
           targetNamespace="http://demobank.example/soap/common"
           elementFormDefault="qualified">

  <xs:simpleType name="CodiceEsito">
    <xs:annotation><xs:documentation>OK00 = success; KOnn = business error; WAnn = warning.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="(OK|KO|WA)[0-9]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="EsitoType">
    <xs:sequence>
      <xs:element name="codice" type="cmn:CodiceEsito"/>
      <xs:element name="descrizione" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="RispostaBase">
    <xs:annotation><xs:documentation>Every response carries the esito envelope.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="esito" type="cmn:EsitoType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="Divisa">
    <xs:restriction base="xs:string">
      <xs:length value="3"/>
      <xs:pattern value="[A-Z]{3}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="ImportoType">
    <xs:sequence>
      <xs:element name="valore">
        <xs:simpleType>
          <xs:restriction base="xs:decimal">
            <xs:totalDigits value="15"/>
            <xs:fractionDigits value="2"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="divisa" type="cmn:Divisa"/>
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="IbanType">
    <xs:restriction base="xs:string">
      <xs:length value="27"/>
      <xs:pattern value="IT[0-9]{2}[A-Z][0-9]{10}[0-9A-Z]{12}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CodiceFiscaleType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z]{6}[0-9LMNPQRSTUV]{2}[A-Z][0-9LMNPQRSTUV]{2}[A-Z][0-9LMNPQRSTUV]{3}[A-Z]"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="PaginazioneRichiesta">
    <xs:sequence>
      <xs:element name="numeroPagina" type="xs:int"/>
      <xs:element name="dimensionePagina">
        <xs:simpleType>
          <xs:restriction base="xs:int">
            <xs:minInclusive value="1"/>
            <xs:maxInclusive value="100"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="PaginazioneRisposta">
    <xs:sequence>
      <xs:element name="numeroPagina" type="xs:int"/>
      <xs:element name="ultimaPagina" type="xs:boolean"/>
      <xs:element name="totaleRecord" type="xs:int" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="ServizioFault">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="codice" type="xs:string"/>
        <xs:element name="messaggio" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
