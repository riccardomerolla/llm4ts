{
  "extends": "../../tsconfig.base.json",
  "include": ["test"],
  "references": [{ "path": "tsconfig.src.json" }, { "path": "../core/tsconfig.src.json" }],
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": true,
    "rootDir": "test",
    "tsBuildInfoFile": ".tsbuildinfo/test.tsbuildinfo",
    "rewriteRelativeImportExtensions": false,
    "allowImportingTsExtensions": true,
    "paths": {
      "@llm4ts/core/*": ["../core/src/*"],
      "@llm4ts/flow/*": ["./src/*"]
    }
  }
}
