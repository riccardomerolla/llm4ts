{
  "name": "@llm4ts/js",
  "version": "0.15.1",
  "description": "Promise and exception facade for llm4ts",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": "./dist/Client.js",
    "./Client": "./dist/Client.js",
    "./Package": "./dist/Package.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "tsc -b tsconfig.json --clean",
    "test": "vitest run test"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riccardomerolla/llm4ts.git",
    "directory": "packages/js"
  },
  "homepage": "https://github.com/riccardomerolla/llm4ts#readme",
  "bugs": {
    "url": "https://github.com/riccardomerolla/llm4ts/issues"
  },
  "keywords": [
    "llm",
    "effect",
    "ai",
    "agents",
    "workflow",
    "typescript"
  ],
  "dependencies": {
    "@llm4ts/core": "workspace:*",
    "@llm4ts/flow": "workspace:*",
    "@llm4ts/runner": "workspace:*"
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.102"
  },
  "devDependencies": {
    "effect": "4.0.0-beta.102"
  }
}
