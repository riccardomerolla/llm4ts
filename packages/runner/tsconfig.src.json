{
  "extends": "../../tsconfig.base.json",
  "include": ["src"],
  "references": [{ "path": "../core/tsconfig.src.json" }, { "path": "../flow/tsconfig.src.json" }],
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": ".tsbuildinfo/src.tsbuildinfo",
    "paths": {
      "@llm4ts/core/*": ["../core/src/*"],
      "@llm4ts/flow/*": ["../flow/src/*"],
      "@llm4ts/runner/*": ["./src/*"]
    }
  }
}
