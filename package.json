{
  "name": "llm4ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/sync-shell-flows.mjs && tsc -b tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean",
    "effect:patch": "effect-language-service patch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint packages examples flows --ext .ts",
    "lint:fix": "eslint packages examples flows --ext .ts --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:verbose": "vitest run --reporter verbose",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "version:set": "node scripts/set-version.mjs"
  },
  "devDependencies": {
    "@effect/language-service": "latest",
    "@effect/vitest": "beta",
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.19.0",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
