{
  "name": "llm4ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "node scripts/sync-shell-flows.mjs && tsc -b tsconfig.json && node scripts/build-web.mjs",
    "clean": "tsc -b tsconfig.json --clean",
    "effect:patch": "effect-language-service patch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "llm4ts": "node packages/shell/dist/cli-main.js",
    "lint": "eslint -c eslint.config.mjs packages examples flows kits --ext .ts",
    "lint:fix": "eslint -c eslint.config.mjs packages examples flows kits --ext .ts --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:verbose": "vitest run --reporter verbose",
    "judgment:replay": "tsx tools/judgment/replay-review.ts",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "unused": "node scripts/unused-modules.mjs",
    "exports:write": "node scripts/unused-modules.mjs --write-exports",
    "version:set": "node scripts/set-version.mjs",
    "judgment:label": "tsx tools/judgment/label.ts",
    "judgment:eval": "tsx tools/judgment/eval.ts"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.5",
    "@effect/vitest": "4.1.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/coverage-v8": "^5.1.1",
    "effect": "4.1.5",
    "esbuild": "0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "geist": "1.9.2",
    "prettier": "^3.10.1",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
