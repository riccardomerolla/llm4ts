# llm4ts environment variables. Nothing loads this file automatically — no
# dotenv dependency, no --env-file flag anywhere in this repo — so source it
# yourself (`set -a; source .env; set +a`), or copy values into your shell's
# environment. Nothing here is required by default: with no variables set,
# every flow's coder/reasoning connector defaults to `claude` (see
# LLM4TS_CODER below); the separate LLM4TS_PROVIDER-based API-provider
# example path (packages/examples' api-provider.ts) defaults to the mock
# connector instead — the two defaults are independent, don't confuse them.
# Uncomment and set only what your workflow actually needs.

# ---------------------------------------------------------------------------
# Coder / reasoning connector selection
# ---------------------------------------------------------------------------

# Which coding agent CLI backs `context.coder` in every flow. Must be
# installed and authenticated. Default: claude.
# LLM4TS_CODER=claude|codex|gemini|pi|agy|grok|cursor|opencode

# Override the coder's model (flow-specific; not every flow reads this).
# LLM4TS_CODER_MODEL=<model-name>

# The reasoning seat some flows split from the coder (e.g. epic-stories).
# Default: claude.
# LLM4TS_REASONER=claude|codex|gemini|pi|agy|grok|cursor|opencode
# LLM4TS_REASONING_MODEL=<model-name>

# Terminal verbosity for the shell/CLI output.
# LLM4TS_VERBOSITY=quiet|normal|verbose|debug

# Prefix each terminal line with a timestamp.
# LLM4TS_TIMESTAMPS=1

# ---------------------------------------------------------------------------
# Direct API provider examples (packages/examples' api-provider.ts)
# ---------------------------------------------------------------------------

# LLM4TS_PROVIDER=openai|anthropic|gemini|lm-studio|ollama|mlx-lm|mock
# LLM4TS_MODEL=<model-name>

# Typed judgments (ADR 0017): the seat they run on defaults to the reasoning
# seat. A small non-thinking model on mlx-lm answers in one forward pass.
# LLM4TS_JUDGMENT_PROVIDER=mlx-lm
# LLM4TS_JUDGMENT_MODEL=/path/to/an/MLX/text/model
# LLM4TS_JUDGMENT_BACKEND=llm|typesafe
# TYPESAFE_API_KEY=            # only for the typesafe backend; header only

# ---------------------------------------------------------------------------
# Provider credentials — only the ones for the connector(s) you actually use
# ---------------------------------------------------------------------------

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Gemini: an AI Studio key, OR Vertex AI, OR Code Assist project, OR a
# personal OAuth login via `gemini auth login` (needs none of these).
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_PROJECT_ID=
# GOOGLE_GENAI_USE_VERTEXAI=true

# ---------------------------------------------------------------------------
# Gemini ACP bridge (ADR 0016) — lets `pi` run on a gemini-cli OAuth
# subscription instead of a model API key.
# ---------------------------------------------------------------------------

# Start the bridge for a pi-coding flow run.
# LLM4TS_GEMINI_BRIDGE=1

# Fixed local port the bridge binds; pi's ~/.pi/agent/models.json must point
# a provider's baseUrl at this same port (llm4ts never writes that file for
# you — see docs/configuration.md and `llm4ts doctor`). Default: 8731.
# LLM4TS_GEMINI_BRIDGE_PORT=8731

# Which entry in pi's models.json names the bridge-routed model, when more
# than one is configured.
# LLM4TS_GEMINI_BRIDGE_MODEL=<provider>/<model>

# The model gemini itself reasons with, inside the bridge's ACP session.
# LLM4TS_GEMINI_MODEL=<model-name>

# ---------------------------------------------------------------------------
# Pack / kit selection (modernize-*, pack-fork, kit flows)
# ---------------------------------------------------------------------------

# A bare pack name, `kit/pack`, or a directory holding pack.md. Default:
# cobol-springboot.
# LLM4TS_PACK=<name>|<kit>/<name>|<path>

# ---------------------------------------------------------------------------
# Workspace read/discover limits (packages/flow/src/Workspace.ts)
# ---------------------------------------------------------------------------

# Per-file read cap, bytes.
# LLM4TS_MAX_READ_BYTES=<n>

# Cap on how many paths workspace.discover returns.
# LLM4TS_MAX_DISCOVER_RESULTS=<n>

# Comma-separated directory names to exclude from discover/search, replacing
# the default exclusion list.
# LLM4TS_EXCLUDE_DIRS=node_modules,dist,.git

# ---------------------------------------------------------------------------
# Context/cost budgeting (packages/flow/src/Context.ts, EstimatedUsage.ts)
# ---------------------------------------------------------------------------

# Character budget capping how much context a judge/analyst prompt embeds.
# Default: 400000.
# LLM4TS_CONTEXT_BUDGET=400000

# No longer read (was a deprecated alias for LLM4TS_CONTEXT_BUDGET) — setting
# this has no effect; use LLM4TS_CONTEXT_BUDGET above.
# LLM4TS_JUDGE_SOURCES_LIMIT=<n>

# Estimated-usage fallback when a provider reports no token counts.
# LLM4TS_ESTIMATE_CHARS_PER_TOKEN=<n>
# LLM4TS_ESTIMATE_MODEL=<model-name>

# ---------------------------------------------------------------------------
# modernize-extract
# ---------------------------------------------------------------------------

# Scope extraction to one wave of the approved wave plan.
# LLM4TS_WAVE=<wave-name>

# Analyst turn/closure-file budgets.
# LLM4TS_ANALYST_TURNS=<n>
# LLM4TS_MAX_CLOSURE_FILES=<n>

# Extract and judge n programs at once. Default: 1 (sequential).
# LLM4TS_EXTRACT_CONCURRENCY=<n>

# ---------------------------------------------------------------------------
# modernize-survey
# ---------------------------------------------------------------------------

# Skip the LLM graph-refine pass.
# LLM4TS_GRAPH_REFINE=off

# ---------------------------------------------------------------------------
# modernize-implement
# ---------------------------------------------------------------------------

# Bounded review/fix rounds per task. Default: 2.
# LLM4TS_JUDGE_ROUNDS=2

# ---------------------------------------------------------------------------
# modernize-refine (ADR 0015)
# ---------------------------------------------------------------------------

# The decision signature recorded in decisions.md; defaults to the OS user.
# LLM4TS_APPROVER=<name>

# Re-run the deterministic domain regrouping pass.
# LLM4TS_REGROUP=1

# The already-modernized target repository modernize-refine verifies
# "provided" dispositions against (also settable via `llm4ts run
# modernize-refine --target <path>`).
# LLM4TS_TARGET_REPO=<path>

# ---------------------------------------------------------------------------
# modernize-pack-upgrade
# ---------------------------------------------------------------------------

# Write a `## Deepen` mark per pack-incompatible program into decisions.md.
# LLM4TS_MARK_DEEPEN=1

# ---------------------------------------------------------------------------
# modernize-bench
# ---------------------------------------------------------------------------

# `report` compares recorded runs instead of executing a new benchmark.
# LLM4TS_BENCH_MODE=report

# Add a named project's per-wave breakdown to the comparison report.
# LLM4TS_BENCH_PROJECT=<name>

# ---------------------------------------------------------------------------
# pack-fork (ADR 0018)
# ---------------------------------------------------------------------------

# Which fixed category list to analyze the target repo with.
# LLM4TS_TARGET_KIND=frontend|backend

# The new forked pack's name, lowercase kebab-case.
# LLM4TS_FORK_AS=<name>

# Revise an existing fork (same LLM4TS_FORK_AS) instead of starting over —
# the prior conventions.md plus this feedback feed every pass, including
# which files get selected as grounding.
# LLM4TS_FEEDBACK=<what to fix or look at again>

# ---------------------------------------------------------------------------
# epic-stories
# ---------------------------------------------------------------------------

# Override the four default verification gates.
# LLM4TS_GATES=pnpm typecheck;pnpm test

# Command preparing a fresh worktree before work starts. Default:
# `pnpm install --offline`.
# LLM4TS_WORKTREE_SETUP=pnpm install --offline

# ---------------------------------------------------------------------------
# kits/j2ee-nextjs's convert-all flow — Azure DevOps work-item mirroring
# ---------------------------------------------------------------------------

# LLM4TS_ADO_ORG_URL=https://dev.azure.com/<org>
# LLM4TS_ADO_PROJECT=<project>
# LLM4TS_ADO_REPO=<repo>

# Stop the whole run on the first page/task that fails verification, instead
# of marking it failed and continuing.
# LLM4TS_FAIL_FAST=1

# ---------------------------------------------------------------------------
# Legacy repository pointer (modernize-seed)
# ---------------------------------------------------------------------------

# The legacy repository modernize-seed pulls the pack out of, when it isn't
# the flow's own --repo.
# LLM4TS_LEGACY_REPO=<path>
